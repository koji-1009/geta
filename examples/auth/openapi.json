                  "type": "string"
                }
              },
              "required": [
                "in",
                "path",
                "message"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "instance": {
            "format": "uri-reference",
            "type": "string"
          },
          "omitted": {
            "minimum": 1,
            "type": "integer"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "format": "uri-reference",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "type": "object"
      },
